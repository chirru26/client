{
  "name": "frontend",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"try { fs.rmSync('node_modules/sharp', { recursive: true, force: true }); fs.rmSync('node_modules/@img', { recursive: true, force: true }); } catch (e) {}\"",
    "build:cf": "npm run build && npx @opennextjs/cloudflare build",
    "deploy": "npm run build:cf && wrangler deploy",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "oxlint": "^1.32.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.146.0"
  }
}
