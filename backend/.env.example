DB_URL=jdbc:postgresql://localhost:5432/chirru_portfolio
DB_USERNAME=chirru
DB_PASSWORD=replace-with-your-database-password

# Generate a random value of at least 32 characters; 64+ is recommended.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Local development can use false. Production must use true over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_SECONDS=900
LOGIN_CLEANUP_INTERVAL_SECONDS=600
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760
